PORT=8080
DB_NAME=todo

# Option A — local MongoDB (recommended for development)
MONGODB_URL=mongodb://127.0.0.1:27017

# Option B — MongoDB Atlas (copy the FULL string from Atlas → Connect → Drivers)
# Must match an active cluster. If you see ENOTFOUND, the hostname is wrong or the cluster was removed.
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net
# Or paste the entire URI including db name:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/todo?retryWrites=true&w=majority

# Comma-separated for multiple origins (e.g. local + Vercel frontend)
CORS_ORIGIN=http://localhost:5173

ACCESS_TOKEN_SECRET=replace_with_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d
JWT_SECRET=replace_with_jwt_secret

EMAIL_ADDRESS=replace_with_email@example.com
EMAIL_PASSWORD=replace_with_email_password

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
NODE_ENV=development

# Comma-separated emails granted admin role (used on register/login)
ADMIN_EMAILS=admin@example.com
